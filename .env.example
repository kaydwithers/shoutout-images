# Copy to .env and fill in. Without keys the app runs in MOCK mode with placeholder images.

# Required for image generation (gpt-image-1). The OpenAI organisation must be verified.
OPENAI_API_KEY=

# Preferred for the concept step (Claude Haiku 5.5). If missing, the concept step falls back to OpenAI.
ANTHROPIC_API_KEY=

# Optional overrides
# CONCEPT_PROVIDER=anthropic   # or "openai"
# MOCK=1                       # force placeholder images even with keys present
# IMAGE_SIZE=1024x1024         # 1024x1024 | 1536x1024 | 1024x1536
# IMAGE_QUALITY=medium         # low | medium | high
# ANTHROPIC_MODEL=claude-haiku-5-5
# OPENAI_TEXT_MODEL=gpt-5-mini
# OPENAI_IMAGE_MODEL=gpt-image-1
